# Copy to .env and fill real values.
TELOXIDE_TOKEN=your_telegram_bot_token
DATABASE_URL=sqlite://shop.db
WEBHOOK_SECRET=change_this_webhook_secret
PORT=8080
LOG_LEVEL=info
ADMIN_JWT_SECRET=change_this_to_at_least_32_random_chars
ADMIN_SETUP_CODE=change_this_setup_code
ADMIN_COOKIE_SECURE=false
RESERVE_TTL_MINUTES=5
# Optional. Usually set from Admin -> Cau hinh Bot -> Admin Telegram.
# Comma/newline-separated Telegram user IDs allowed to send sticker/GIF and receive file_id.
TELEGRAM_ICON_ADMIN_IDS=

# Website stock import. Keep the key only on the bot server; do not send it in Telegram.
# Add this bot server's public IP to the website API whitelist for the API-key user.
CAFFEMMO_STOCK_IMPORT_URL=https://your-domain.example/api/importAccount.php
CAFFEMMO_STOCK_API_KEY=replace_with_a_rotated_stock_api_key

# Optional second bot used only for customer support. It shares DATABASE_URL with
# the main bot, but must use a different token created via @BotFather.
# SUPPORT_BOT_TOKEN=your_support_bot_token
# Backward-compatible: SUPPORT_ADMIN_IDS is treated as the manager list.
# SUPPORT_ADMIN_IDS=123456789
# SUPPORT_MANAGER_IDS=123456789
# SUPPORT_AGENT_IDS=234567890,345678901
# SUPPORT_CASE_PREFIX=SUP
# SUPPORT_OVERDUE_MINUTES=30

# USDT/Binance Pay/BEP20 credentials are optional and should normally be set
# in Admin -> Cau hinh. Leave them out of .env unless this bot needs fixed
# environment defaults for a fresh install.
